" vim: ts=4:sts=4:sw=4:et:ft=vim:
" ====== 基础设置 ======
set nocompatible
set encoding=utf-8
filetype on
filetype indent on
syntax enable
set backspace=indent,eol,start
" set autoindent
set showmatch
set listchars=tab:→\ ,extends:›,precedes:‹
set hlsearch
let mapleader = " "
set iskeyword+=-
set colorcolumn=+1
set modeline
set modelines=5
set signcolumn=yes

" 视觉增强
set number
set relativenumber
set cursorline
set t_ut=
set scrolloff=8
set sidescrolloff=8
set splitright
set splitbelow
set showtabline=2
set list
