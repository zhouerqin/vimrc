" vim: ts=4:sts=4:sw=4:et:ft=vim:
" ====== 基础设置 ======
set nocompatible
set encoding=utf-8
filetype on
filetype indent on
syntax enable
set backspace=indent,eol,start
set autoindent
set showmatch
set listchars=tab:→\ ,trail:·
set hlsearch
let mapleader = " "
set iskeyword+=-
set colorcolumn=+1
set modeline
set modelines=5
